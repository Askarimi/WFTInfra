<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Controllers\ABACController.cs" />
	  <Compile Remove="Controllers\AttributeDefinitionsController.cs" />
	  <Compile Remove="Controllers\AttributeGroupsController.cs" />
	  <Compile Remove="Controllers\ConditionOperatorsController.cs" />
	  <Compile Remove="Controllers\CountryController.cs" />
	  <Compile Remove="Controllers\PermissionsController .cs" />
	  <Compile Remove="Controllers\PolicyRulesController.cs" />
	  <Compile Remove="Controllers\RolePolicyAssignmentController.cs" />
	  <Compile Remove="Controllers\RolesController.cs" />
	  <Compile Remove="Controllers\UserPasswordController.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.4" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\WFT.Infra.Bootstrapper\WFT.Infra.Bootstrapper.csproj" />
	</ItemGroup>

</Project>
